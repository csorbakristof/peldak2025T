<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="TemperatureMonitoring.Model"
             xmlns:oxy="clr-namespace:OxyPlot.Maui.Skia;assembly=OxyPlot.Maui.Skia"
             x:Class="TemperatureMonitoring.View.StatisticsPage"
             Title="StatisticsPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="250" />
            <RowDefinition Height="300" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500" />
            <ColumnDefinition Width="250" />
        </Grid.ColumnDefinitions>
        <Image Source="thermometer.png" Grid.Row="0" Grid.Column="1"/>

        <oxy:PlotView BackgroundColor="LightGray" x:Name="PlotView" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"/>


    </Grid>
</ContentPage>
